{
  "id": "flux1-lora-trainer",
  "version": "1.1.0",
  "name": "Flux.1 LoRA Trainer",
  "description": "Train LoRA adapters on FLUX.1-dev using your own images. Outputs a .safetensors file ready for ComfyUI.",
  "badge": "Training",
  "model": "black-forest-labs/FLUX.1-dev",
  "engine": "api",
  "server": {
    "type": "training",
    "script": "server.py",
    "port": 8770,
    "healthEndpoint": "/health",
    "generateEndpoint": "/train",
    "trainEndpoint": "/train",
    "progressEndpoint": "/train/{jobId}/progress",
    "cancelEndpoint": "/train/{jobId}/cancel"
  },
  "dependencies": {
    "python": ">=3.10",
    "packages": [
      "torch",
      "torchvision",
      "diffusers>=0.31.0",
      "transformers",
      "accelerate",
      "peft",
      "safetensors",
      "fastapi",
      "uvicorn",
      "pillow",
      "bitsandbytes",
      "prodigyopt",
      "wandb"
    ]
  },
  "schema": {
    "inputs": [
      { "paramName": "datasetId", "paramType": "string", "label": "Dataset ID" },
      { "paramName": "outputName", "paramType": "string", "label": "Output Name" },
      { "paramName": "triggerWord", "paramType": "string", "label": "Trigger Word", "defaultValue": "ohwx" },
      { "paramName": "steps", "paramType": "number", "label": "Training Steps", "defaultValue": 1000 },
      { "paramName": "lr", "paramType": "string", "label": "Learning Rate", "defaultValue": "1e-4" },
      { "paramName": "rank", "paramType": "number", "label": "LoRA Rank", "defaultValue": 128 },
      { "paramName": "resolution", "paramType": "number", "label": "Resolution", "defaultValue": 1024 }
    ],
    "outputs": [
      { "paramName": "lora_file", "paramType": "file", "label": "Trained LoRA" }
    ]
  },
  "cloud": {
    "modal": {
      "supported": true,
      "defaultGpu": "A100-40GB",
      "containerIdleTimeout": 120
    }
  }
}
